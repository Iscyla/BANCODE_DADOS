CREATE DATABASE estoque;

USE estoque;

CREATE TABLE usuarios(
id_usuario INT AUTO_INCREMENT PRIMARY KEY,
nome VARCHAR(100),
cargo VARCHAR(50),
departamento VARCHAR(50),
ativo BOOLEAN DEFAULT TRUE,
email VARCHAR(45) UNIQUE,
senha VARCHAR(45),
perfil ENUM('ADM', 'GERENTE', 'VENDEDOR', 'ESTOQUISTA', 'VISUALIZADOR')
);

CREATE TABLE clientes(
-- DADOS PESSOAIS
id_cliente INT AUTO_INCREMENT PRIMARY KEY,
nome_cliente VARCHAR(100),
CPF_CNPJ VARCHAR(20) UNIQUE,
tipo ENUM('FÍSICO', 'JURÍDICO'),
email_cliente VARCHAR(45) UNIQUE,
telefone VARCHAR(20),
-- ENDEREÇO
cidade VARCHAR(100),
estado CHAR(2),
cep VARCHAR (10),
logradouro VARCHAR(100),
pais VARCHAR(20),
numero VARCHAR (5),
bairro VARCHAR(20),
complemento VARCHAR(50),
-- ADICIONAIS
limite_credito DECIMAL(10,2),
data_cadastro DATETIME
);

CREATE TABLE pedidos(
id_pedido INT AUTO_INCREMENT PRIMARY KEY,
cod_cliente INT,
cod_usuario INT,
data_pedido DATE,
status_pedido  ENUM('PENDENTE','CONCLUIDO','CANCELADO','EM_ANDAMENTO'),
valor_total DECIMAL(10,2),
FOREIGN KEY (cod_cliente) REFERENCES clientes(id_cliente),
FOREIGN KEY (cod_usuario) REFERENCES usuarios(id_usuario)
);

CREATE TABLE produtos(
id_produto INT AUTO_INCREMENT PRIMARY KEY,
nome_produto VARCHAR(100),
categoria VARCHAR(50),
sku VARCHAR(50),
preco_custo DECIMAL (10,2),
preco_venda DECIMAL (10,2),
qauantidade_estoque INT,
estoque_minimo INT DEFAULT 0,
status_produto BOOLEAN DEFAULT TRUE,
fornecenador VARCHAR(50) NOT NULL
);

CREATE TABLE itens_pedido(
id_item INT AUTO_INCREMENT PRIMARY KEY,
cod_pedido INT,
cod_produto INT,
quantidade INT,
preco_unitario DECIMAL (10,2),
desconto_percentual DECIMAL(5,2),
FOREIGN KEY (cod_pedido) REFERENCES pedidos(id_pedido),
FOREIGN KEY (cod_produto) REFERENCES produtos(id_produto)
);

CREATE TABLE pagamentos (
id_pagamento INT AUTO_INCREMENT PRIMARY KEY,
id_pedido INT,
metodo_pagamento ENUM('PIX', 'CREDITO', 'DEBITO', 'DINHEIRO', 'BOLETO', 'TICKET'),
valor_pago DECIMAL(10,2),
status_pagamento ENUM('pendente','aprovado','recusado'),
FOREIGN KEY (id_pedido) REFERENCES pedidos(id_pedido)
);


