-- LISTA DE VIEWS
CREATE OR REPLACE VIEW vw_produtos_ativos AS 
SELECT id_produto, sku, nome_produto, categoria, preco_venda, qauantidade_estoque, status_produto
FROM produtos
WHERE status_produto = TRUE;

SELECT * FROM vw_produtos_ativos;

-- Lista de produtos com estoque abaixo do minimo
CREATE OR REPLACE VIEW vw_alerta_estoque_minimo AS
SELECT sku, nome_produto, fornecenador, qauantidade_estoque, estoque_minimo
FROM produtos
WHERE qauantidade_estoque <= estoque_minimo AND status_produto = TRUE;

SELECT * FROM vw_alerta_estoque_minimo;

-- VIEWS PARA GESTÃO DE CLIENTES
-- Lista os dados dos cliente para o marketing, ocultando informações sensíveis
CREATE OR REPLACE VIEW vw_contatos_marketing AS
SELECT nome_cliente, email_cliente, telefone, cidade, estado
FROM clientes
WHERE email_cliente IS NOT NULL;

SELECT * FROM vw_contatos_marketing;

-- Lista de clientes fisicos
CREATE OR REPLACE VIEW vw_cliente_fisico AS
SELECT id_cliente, nome_cliente, CPF_CNPJ AS CPF
FROM clientes
WHERE tipo = 'FISICO';

SELECT * FROM vw_cliente_fisico;

-- Lista de clientes juridicos
CREATE OR REPLACE VIEW vw_cliente_juridico AS
SELECT id_cliente, nome_cliente, CPF_CNPJ AS CNPJ
FROM clientes
WHERE tipo = 'JURIDICO';

SELECT * FROM vw_cliente_juridico;

-- VIEWS PARA VENDAS+
-- VIEWS PARA RESUMO DE VENDAS
CREATE OR REPLACE VIEW vw_resumo_pedidos AS
SELECT p.cod_cliente, p.data_pedido, c.nome_cliente AS cliente, p.status_pedido, p.valor_total
FROM pedidos AS P
JOIN clientes AS c ON p.cod_cliente = c.id_cliente
JOIN usuarios AS u ON p.cod_usuario = u.id_usuario;

SELECT * FROM vw_resumo_pedidos;



